# --- Compose ---
# Remove docker-compose.traefik.yaml to run without the reverse proxy.
COMPOSE_FILE=docker-compose.yaml:docker-compose.traefik.yaml

# --- wireguard image (WireGuard + UI fork + Seafile) ---
# Built by GitHub Actions on every push to main and published to GHCR. Override to run a
# locally built or differently tagged image (e.g. a :sha-xxxxxxx tag to pin a build).
# WG_IMAGE=ghcr.io/serhiicherepanov/wireguard-ui-stack:latest
# WGUI_FORK_REPO=https://github.com/Skyline-core/wireguard-ui.git
# Full commit sha or tag. Bump, then: docker compose build --pull && docker compose up -d
# WGUI_FORK_REF=fceb94000d415e1365885fc05c586486ac23a10b
# Base image for the runtime stage (Seafile CE). Bump, then rebuild as above.
# SEAFILE_IMAGE=seafileltd/seafile-mc:11.0-latest

# --- Traefik / ACME (HTTP-01 challenge on :80) ---
ACME_EMAIL=you@example.com
TRAEFIK_LOG_LEVEL=INFO
# htpasswd format, escape $ as $$ if using bcrypt/md5
TRAEFIK_DASHBOARD_USERS=admin:{SHA}xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- WireGuard ---
TZ=Asia/Tbilisi
# Public hostname: WireGuard endpoint for clients and Traefik Host() rule for the UI.
WG_HOST=wg.example.com
WG_PORT=51821
# Server-side interface address. Used only when the UI DB is created for the first time;
# afterwards edit it on the Server page in the UI.
WG_SERVER_ADDRESS=10.13.13.1/24
# Optional PostUp/PostDown for wg0 (first-run default only). Example for NAT to the internet:
# WG_POST_UP=iptables -t nat -A POSTROUTING -o eth+ -j MASQUERADE
# WG_POST_DOWN=iptables -t nat -D POSTROUTING -o eth+ -j MASQUERADE
WG_POST_UP=
WG_POST_DOWN=
# --- Without the traefik overlay: where the container's HTTP is published ---
# nginx with Seafile at / and the UI at /wg. Point your own reverse proxy at this address
# and forward Host + X-Forwarded-Proto. Localhost only by default.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
# Tell Seafile its public URL is https:// (your proxy terminates TLS). First-run only.
# The traefik overlay sets this on its own.
SEAFILE_FORCE_HTTPS=true
# UI directly, bypassing nginx (also under /wg). Not needed when HTTP_PORT is proxied.
WGUI_BIND=127.0.0.1
WGUI_PORT=5000
# URL prefix of the UI, everywhere: https://$WG_HOST/wg (Traefik), http://<wg address>/wg
# (through the tunnel, served by Seafile's nginx) and http://127.0.0.1:5000/wg. Keep it
# non-empty: Seafile owns / on the same host.
WGUI_BASE_PATH=/wg

# --- WireGuard UI ---
WGUI_DEFAULT_CLIENT_ALLOWED_IPS=10.13.13.0/24
WGUI_DNS=1.1.1.1
WGUI_LOG_LEVEL=INFO
# Random string; without it sessions are invalidated on every restart.
WGUI_SESSION_SECRET=
# Initial admin user. Used only when the UI DB is created for the first time.
WGUI_USERNAME=admin
WGUI_PASSWORD=admin
TELEGRAM_TOKEN=
TELEGRAM_ALLOW_CONF_REQUEST=true

# --- Seafile (inside the wireguard container, served by Traefik at https://$SEAFILE_HOST/) ---
# Domain Seafile is served on. Defaults to WG_HOST, i.e. Seafile at https://$WG_HOST/ and the
# UI at https://$WG_HOST/wg. Set it only for a separate domain (it must then also resolve
# to this host; Traefik gets its certificate the same way as for WG_HOST).
# First-run default: it ends up in seafile/data/seafile/conf/seahub_settings.py
# (SERVICE_URL, FILE_SERVER_ROOT, CSRF_TRUSTED_ORIGINS) and in
# seafile/data/nginx/conf/seafile.nginx.conf. To change it later edit the former and delete
# the latter (re-rendered on next start).
# SEAFILE_HOST=
# MariaDB root password (container seafile-db). Seafile uses it on first run to create its
# own DB user; afterwards it is read from seafile/data/seafile/conf/seafile.conf.
SEAFILE_DB_ROOT_PASSWORD=
# Initial Seafile admin. First-run defaults only; change them in Seafile afterwards.
SEAFILE_ADMIN_EMAIL=admin@example.com
SEAFILE_ADMIN_PASSWORD=
